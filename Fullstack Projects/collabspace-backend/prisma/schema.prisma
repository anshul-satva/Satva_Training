generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum OrganizationRole {
  ADMIN
  MANAGER
  MEMBER
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

model User {
  id                  String               @id @default(cuid())
  name                String?
  email               String               @unique
  passwordHash        String
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  organizationMembers OrganizationMember[]
  assignedTasks       Task[]               @relation("TaskAssignee")
  createdTasks        Task[]               @relation("TaskCreator")
  comments            Comment[]
  activityLogs        ActivityLog[]
  previousAssignments AssignmentHistory[]  @relation("PreviousAssignee")
  newAssignments      AssignmentHistory[]  @relation("NewAssignee")
  assignmentChanges   AssignmentHistory[]  @relation("AssignmentChangedBy")
}

model Organization {
  id          String               @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  members     OrganizationMember[]
  projects    Project[]
  tasks       Task[]
  tags        Tag[]
  comments    Comment[]
  activities  ActivityLog[]
}

model OrganizationMember {
  id             String           @id @default(cuid())
  organizationId String
  userId         String
  role           OrganizationRole @default(MEMBER)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
}

model Project {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?
  deletedAt      DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tasks          Task[]
}

model Task {
  id                String              @id @default(cuid())
  organizationId    String
  projectId         String
  title             String
  description       String?
  status            TaskStatus          @default(TODO)
  assignedUserId    String?
  createdById       String?
  archivedAt        DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  organization      Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project           Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignedUser      User?               @relation("TaskAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)
  createdBy         User?               @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  comments          Comment[]
  activities        ActivityLog[]
  assignmentHistory AssignmentHistory[]
  taskTags          TaskTag[]
}

model Comment {
  id             String   @id @default(cuid())
  organizationId String
  taskId         String
  userId         String
  content        String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  task           Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Tag {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  color          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  taskTags       TaskTag[]

  @@unique([organizationId, name])
}

model TaskTag {
  taskId String
  tagId  String
  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tag    Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([taskId, tagId])
}

model ActivityLog {
  id             String      @id @default(cuid())
  organizationId String
  projectId      String
  taskId         String
  userId         String
  action         String
  previousStatus TaskStatus?
  newStatus      TaskStatus?
  createdAt      DateTime    @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  task           Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AssignmentHistory {
  id                   String   @id @default(cuid())
  organizationId       String
  projectId            String
  taskId               String
  previousAssignedUserId String?
  newAssignedUserId    String?
  changedById          String
  changedAt            DateTime @default(now())
  task                 Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  previousAssignedUser User?    @relation("PreviousAssignee", fields: [previousAssignedUserId], references: [id], onDelete: SetNull)
  newAssignedUser      User?    @relation("NewAssignee", fields: [newAssignedUserId], references: [id], onDelete: SetNull)
  changedBy            User     @relation("AssignmentChangedBy", fields: [changedById], references: [id], onDelete: Cascade)
}
