<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <appSettings>
    <!--
      EncryptionKey: Secret key used for AES-256 password encryption.
      In production, store this in a secrets manager (Azure Key Vault, AWS Secrets Manager, etc.)
    -->
    <add key="EncryptionKey"    value="Emp@Secur3K3y!2024#AES256Bit" />

    <!--
      EmployeeFilePath: Relative or absolute path where employee JSON records are stored.
    -->
    <add key="EmployeeFilePath" value="data/employees.json" />
  </appSettings>

  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
</configuration>
