<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<appSettings>
		<!-- Days to keep. Files older than this many days are deleted from LogPaths. -->
		<add key="RetentionDays" value="7" />

		<!-- OPTION 1: Comma-separated paths only. -->
		<add key="LogPaths" value="C:\Logs, C:\Logs2" />
	</appSettings>

	<startup>
		<supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.5" />
	</startup>
</configuration>
