  "components": {
    "schemas": {
      "Item": {
        "required": [
          "name"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "nullable": true
          },
          "name": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "price": {
            "maximum": 999999.99,
            "minimum": 0.01,
            "type": "number",
            "format": "double"
          },
          "quantity": {
            "maximum": 99999,
            "minimum": 0,
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "ItemPatch": {
        "type": "object",
        "properties": {
          "name": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string",
            "nullable": true
          },
          "price": {
            "maximum": 999999.99,
            "minimum": 0.01,
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "quantity": {
            "maximum": 99999,
            "minimum": 0,
            "type": "integer",
            "format": "int32",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "LoginRequest": {
        "required": [
          "emailID",
          "password"
        ],
        "type": "object",
        "properties": {
          "emailID": {
            "minLength": 1,
            "type": "string",
            "format": "email"
          },
          "password": {
            "minLength": 6,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "User": {
        "required": [
          "emailID",
          "name",
          "password",
          "role"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "nullable": true
          },
          "name": {
            "maxLength": 50,
            "minLength": 2,
            "type": "string"
          },
          "emailID": {
            "minLength": 1,
            "type": "string",
            "format": "email"
          },
          "password": {
            "minLength": 6,
            "type": "string"
          },
          "role": {
            "minLength": 1,
            "pattern": "^(Admin|NormalUser)$",
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "UserPatch": {
        "type": "object",
        "properties": {
          "name": {
            "maxLength": 50,
            "minLength": 2,
            "type": "string",
            "nullable": true
          },
          "emailID": {
            "type": "string",
            "format": "email",
            "nullable": true
          },
          "password": {
            "minLength": 6,
            "type": "string",
            "nullable": true
          },
          "role": {
            "pattern": "^(Admin|NormalUser)$",
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "Bearer": {
        "type": "http",
        "description": "Enter: Bearer {your token here}",
        "scheme": "Bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "security": [
    {
      "Bearer": [ ]
